ORTHOS2_NETBOX_AUTH_SCHEME=
ORTHOS2_NETBOX_URL=
ORTHOS2_SUPERUSER_PASSWORD=
# Must be set to a Postgres-backed engine (e.g. django.db.backends.postgresql)
# and a real host/name/user below. Leaving this unset/empty makes Orthos2
# silently fall back to a local, per-pod SQLite file, which is not shared
# between the web and taskmanager pods and is lost on every pod restart.
ORTHOS2_DB_ENGINE=
ORTHOS2_POSTGRES_HOST=
ORTHOS2_POSTGRES_PORT=
ORTHOS2_POSTGRES_NAME=
ORTHOS2_POSTGRES_USER=
# ORTHOS2_POSTGRES_PASSWORD is intentionally not listed here: unlike
# OrthosKey/NetboxToken/OIDCsecret (read from /run/secrets/* files by the
# container entrypoint), Django reads ORTHOS2_POSTGRES_PASSWORD directly as a
# plain environment variable at process start (see orthos2/settings.py and
# docker/orthos/orthos2dev.env upstream), so it is injected straight from the
# "orthos2" Secret's OrthosPostgresPassword key via secretKeyRef instead of
# this ConfigMap.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
CSRF_ALLOWED_ORIGIN=
CROSS_ORIGINS_WHITELIST=
OIDC_ENDPOINT=
OIDC_KEY=
ORTHOS2_STATIC_ROOT=
ORTHOS2_SERVER_FQDN=
ORTHOS2_BASE_URL=
NETBOX_SUPERUSER_NAME=
NETBOX_SUPERUSER_PASSWORD=
